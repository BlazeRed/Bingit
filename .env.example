# Copy to .env.local and fill in. Variables starting with VITE_ end up in the browser bundle; others do not.

# Simkl app (AUTH V2, type "Mobile, desktop & browser apps"): https://simkl.com/settings/developer/
VITE_SIMKL_CLIENT_ID=

# TMDB API read access token (v4 auth): https://www.themoviedb.org/settings/api
# Secret: only the server-side proxy reads it. Never add the VITE_ prefix.
TMDB_TOKEN=
