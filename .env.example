# Copy to .env.local and fill in. Both values end up in the browser bundle: they are public identifiers, not secrets.

# Simkl app (AUTH V2, type "Mobile, desktop & browser apps"): https://simkl.com/settings/developer/
VITE_SIMKL_CLIENT_ID=

# TMDB API read access token (v4 auth): https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=
